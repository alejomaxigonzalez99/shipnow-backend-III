# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Logging: fatal, error, warning, info, http, debug
# Por defecto: debug (development), info (production), warning (test)
LOG_LEVEL=debug

# Servicios externos (opcionales)
TRACKING_SERVICE_URL=
NOTIFICATIONS_SERVICE_URL=